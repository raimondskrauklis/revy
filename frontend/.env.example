# frontend/.env.example
# Copy to frontend/.env.local for local `npm run dev`
#
#   cp .env.example .env.local
#
# Dev bootstrap: docs/starter-pack/DEV_BOOTSTRAP.md
# Registration flags: docs/starter-pack/REGISTRATION_FLAGS.md

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=revy
VITE_KEYCLOAK_CLIENT_ID=revy-web

# Registration UI gates — mirror backend REGISTRATION_* (docs/starter-pack/REGISTRATION_FLAGS.md)
VITE_REGISTRATION_REQUIRE_ADMIN_APPROVAL=false
VITE_REGISTRATION_REQUIRE_PROFILE_FORM=false

# Sentry — browser error tracking + session replay
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=local
# VITE_SENTRY_SEND_DEFAULT_PII=false
# VITE_SENTRY_ENABLE_SCREENSHOT=false
