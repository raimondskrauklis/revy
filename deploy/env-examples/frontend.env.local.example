# deploy/env-examples/frontend.env.local.example
# Copy to frontend/.env.local for LOCAL `npm run dev` ONLY.
#
# cp deploy/env-examples/frontend.env.local.example frontend/.env.local
#
# Vite exposes only variables prefixed with VITE_ to the browser.
# Production: these values are NOT read from the droplet — they are injected in
# GitHub Actions during `npm run build` and baked into frontend/dist.
#
# See: frontend/.env.example, frontend.env.production.example

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=revy
VITE_KEYCLOAK_CLIENT_ID=revy-web

# Optional — match production if testing dashboard integrations
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=local
# VITE_SENTRY_SEND_DEFAULT_PII=false
# VITE_SENTRY_ENABLE_SCREENSHOT=false

# Ops dashboard feature flags (add as product grows)
# VITE_REVY_DASHBOARD_ENABLED=true
