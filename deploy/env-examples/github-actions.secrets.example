# deploy/env-examples/github-actions.secrets.example
# GitHub repository → Settings → Secrets and variables → Actions
#
# Rule: VITE_* → build-time (validate + deploy jobs). Backend secrets for CI tests
# use CI_* prefix. Production backend runtime secrets live ONLY on droplet .env.

# =============================================================================
# Deploy / infrastructure
# =============================================================================
# DOCR_TOKEN=                    # Registry password ONLY (username in workflow is always `doctoken`).
#                                # NOT the dop_v1_ API token (that is DIGITALOCEAN_ACCESS_TOKEN).
#                                # DO → Container Registry → your registry → Settings → Download Docker Credentials.
#                                # In the JSON, copy the `auth` value, then:
#                                #   echo '<auth>' | base64 -d
#                                # Output is `doctoken:<password>` — put ONLY <password> in DOCR_TOKEN.
#                                # Quick test locally:
#                                #   echo "$DOCR_TOKEN" | docker login registry.digitalocean.com -u doctoken --password-stdin
# DROPLET_IP=
# SSH_PRIVATE_KEY=               # deploy@droplet private key (ed25519, no passphrase). See docs/utils/deploy-user-migration.md
# DO_DB_ID=                      # Managed PG cluster UUID — CI validate only (SKIP_CI_TESTS=false)

# =============================================================================
# Frontend build-time (VITE_*) — required for npm run build in CI
# See frontend.env.production.example for value shapes.
# =============================================================================
# VITE_API_BASE_URL=https://revy.createit.digital/api/v1
# VITE_KEYCLOAK_URL=https://auth.revy.createit.digital
# VITE_KEYCLOAK_REALM=revy
# VITE_KEYCLOAK_CLIENT_ID=revy-web
# VITE_REGISTRATION_REQUIRE_ADMIN_APPROVAL=false
# VITE_REGISTRATION_REQUIRE_PROFILE_FORM=false

# Optional frontend observability (production deploy job)
# VITE_SENTRY_DSN=
# VITE_SENTRY_SEND_DEFAULT_PII=false
# VITE_SENTRY_ENABLE_SCREENSHOT=false
# SENTRY_AUTH_TOKEN=             # Sourcemap upload at build time
# SENTRY_ORG=
# SENTRY_PROJECT=

# =============================================================================
# CI validation job — backend tests / alembic (not production droplet)
# =============================================================================
# CI_TEST_DATABASE_URL=postgresql+asyncpg://...@.../revy_test?ssl=require
# CI_REDIS_URL=redis://localhost:6379/1
# CI_SECRET_KEY=ci-test-secret-key
# CI_KEYCLOAK_URL=http://localhost:8080
# CI_KEYCLOAK_REALM=revy
# CI_KEYCLOAK_CLIENT_ID=revy-api
# CI_KEYCLOAK_CLIENT_SECRET=ci-test-secret

# Optional: CI validate — doctl DB firewall whitelist (SKIP_CI_TESTS=false)
# DIGITALOCEAN_ACCESS_TOKEN=   # dop_v1_… API token (separate from DOCR_TOKEN)

# =============================================================================
# NOT in GitHub Secrets (droplet /mnt/revy/backend/.env only)
# =============================================================================
# DATABASE_URL          — production DB
# VOYAGE_API_KEY         — R3 embeddings (API path; required for index + R4 context)
# MOONSHOT_API_KEY       — R4 primary reviewer (Kimi K2.7 Code / K3)
# ANTHROPIC_API_KEY      — R5 judge / cross-family escalation
# GITHUB_APP_PRIVATE_KEY (file on volume)
# GITHUB_WEBHOOK_SECRET
# KEYCLOAK_CLIENT_SECRET — production
# KEYCLOAK_ISSUER=https://auth.revy.createit.digital/realms/revy  # JWT iss when KEYCLOAK_URL is internal docker host
# REDIS_PASSWORD
