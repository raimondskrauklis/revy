# deploy/env-examples/deploy.workflow.env.example
# Snippet for .github/workflows/deploy.yml
#
# Top-level workflow `env:` (adjust registry name):

# env:
#   REGISTRY: registry.digitalocean.com
#   REGISTRY_NAME: revy-container-registry
#   BACKEND_IMAGE: revy-api
#   FRONTEND_IMAGE: revy-web
#   BACKEND_CONTAINER_NAME: revy-api
#   FRONTEND_CONTAINER_NAME: revy-web
#   DOCKER_NETWORK: revy-net
#   ENV_FILE_PATH: /opt/revy/backend/.env
#   RESTART_WORKERS: "true"

# validate + deploy-production job `env:` (VITE baked at build):

# env:
#   NODE_OPTIONS: "--max-old-space-size=4096"
#   VITE_API_BASE_URL: ${{ secrets.VITE_API_BASE_URL }}
#   VITE_KEYCLOAK_URL: ${{ secrets.VITE_KEYCLOAK_URL }}
#   VITE_KEYCLOAK_REALM: ${{ secrets.VITE_KEYCLOAK_REALM }}
#   VITE_KEYCLOAK_CLIENT_ID: ${{ secrets.VITE_KEYCLOAK_CLIENT_ID }}
#   VITE_REGISTRATION_REQUIRE_ADMIN_APPROVAL: ${{ secrets.VITE_REGISTRATION_REQUIRE_ADMIN_APPROVAL }}
#   VITE_REGISTRATION_REQUIRE_PROFILE_FORM: ${{ secrets.VITE_REGISTRATION_REQUIRE_PROFILE_FORM }}
#   # CI backend (validate job only):
#   ENVIRONMENT: test
#   DATABASE_URL: ${{ secrets.CI_TEST_DATABASE_URL }}
#   TEST_DATABASE_URL: ${{ secrets.CI_TEST_DATABASE_URL }}
#   KEYCLOAK_URL: ${{ secrets.CI_KEYCLOAK_URL }}
#   KEYCLOAK_REALM: ${{ secrets.CI_KEYCLOAK_REALM }}
#   KEYCLOAK_CLIENT_ID: ${{ secrets.CI_KEYCLOAK_CLIENT_ID }}
#   KEYCLOAK_CLIENT_SECRET: ${{ secrets.CI_KEYCLOAK_CLIENT_SECRET }}
#   REDIS_URL: ${{ secrets.CI_REDIS_URL }}
#   SECRET_KEY: ${{ secrets.CI_SECRET_KEY }}
#   ALLOWED_ORIGINS: http://localhost:5173
