# deploy/env-examples/backend.env.production.example
# Production runtime — server path: /opt/revy/backend/.env
# Permissions: chmod 640, owned by deploy (readable for docker --env-file).
#
# cp deploy/env-examples/backend.env.production.example /opt/revy/backend/.env
#
# Mounted into: revy-api, revy-worker*, revy-beat (and revy-kc — Keycloak section below).
# NOT used by revy-web (static SPA — VITE_* baked at CI build time).
#
# Container DNS names apply inside revy-net (e.g. redis, keycloak).

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
SECRET_KEY=GENERATE_WITH_python_-c_import_secrets_token_urlsafe_48
ALLOWED_ORIGINS=https://app.example.com

# -----------------------------------------------------------------------------
# Database — PostgreSQL 17 + pgvector
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://revy_app:CHANGE_ME@db-host:5432/revy?ssl=require

# -----------------------------------------------------------------------------
# Redis — revy-redis container on same droplet
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------------------------------------------------------
# Keycloak — revy-kc container (also set KC_* for the Keycloak image)
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=revy
# Public OIDC issuer — must match JWT `iss` from browser login (see deploy/nginx/auth.*.conf)
KEYCLOAK_ISSUER=https://auth.example.com/realms/revy
KEYCLOAK_CLIENT_ID=revy-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_FRONTEND_CLIENT_ID=revy-web
# KEYCLOAK_WEBHOOK_SECRET=

REGISTRATION_REQUIRE_ADMIN_APPROVAL=false
REGISTRATION_REQUIRE_PROFILE_FORM=false

# Keycloak server bootstrap (container env — often duplicated in compose `environment:`)
# sepertate env for keycloak
# -----------------------------------------------------------------------------
# GitHub App
# -----------------------------------------------------------------------------
# GITHUB_APP_ID = App settings → About → App ID (NOT the installation URL id)
# Setup/Callback hops use GITHUB_OAUTH_PUBLIC_BASE (API origin), not APP_PUBLIC_URL (SPA).
# Prod API origin: https://app.example.com — local: http://localhost:8000 (not :5173).
# GITHUB_CLIENT_SECRET signs install HMAC `state` (TTL 1800s) and later OAuth token exchange.
# App JWT: iat = now-60, exp = iat+600 — see docs/utils/GITHUB_APP_SETUP.md § App JWT
# Live GitHub App dashboard Setup/Callback paste is P4 — env shape only until then.
GITHUB_APP_ID=
GITHUB_APP_SLUG=revy
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_PUBLIC_BASE=https://app.example.com
# GITHUB_INSTALL_STATE_TTL_SECONDS=1800
GITHUB_APP_PRIVATE_KEY_PATH=/opt/revy/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
REVY_BOT_LOGIN=<app-slug>[bot]

# -----------------------------------------------------------------------------
# Embeddings (R3) — architecture.md §11.3.1; API first, local parallel track
# -----------------------------------------------------------------------------
REVY_EMBEDDING_BACKEND=voyage
VOYAGE_API_KEY=
REVY_EMBEDDING_MODEL=voyage-code-3
# Must include leading "v" — typos like "oyage-code-3" return Voyage HTTP 400
REVY_EMBEDDING_DIMENSIONS=1024
# REVY_HF_CACHE_PATH=/data/hf-cache
# REVY_LOCAL_EMBEDDING_MODEL=jina-embeddings-v2-base-code
# REVY_RERANKER_BACKEND=bge-reranker-v2-m3

# -----------------------------------------------------------------------------
# LLM review (R4) + judge (R5) — RTU origin, Moonshot/Anthropic switch-back
# -----------------------------------------------------------------------------
REVY_LLM_PROVIDER=rtu
REVY_REVIEWER_PROVIDER=rtu
REVY_JUDGE_PROVIDER=rtu
# Replace with your LLM gateway or direct provider base URL.
RTU_API_BASE=https://llm-gateway.example.com
RTU_API_KEY=
REVY_RTU_MODEL_STANDARD=azure_ai/kimi-k2.7-code
REVY_RTU_MODEL_DEEP=azure_ai/claude-fable-5-1
REVY_RTU_MODEL_CRITICAL=azure_ai/claude-fable-5-1
REVY_RTU_MODEL_JUDGE=azure_ai/claude-opus-5
# Moonshot.ai — unused while reviewer is rtu
REVY_MOONSHOT_MODEL_STANDARD=kimi-k2.7-code
REVY_MOONSHOT_MODEL_DEEP=kimi-k3
REVY_MOONSHOT_MODEL_CRITICAL=kimi-k3
# REVY_MOONSHOT_MAX_COMPLETION_TOKENS=32768
MOONSHOT_API_BASE=https://api.moonshot.ai/v1
MOONSHOT_API_KEY=
# Direct Anthropic unused while providers are rtu
ANTHROPIC_API_KEY=
REVY_ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=   # Anthropic-compatible proxy only — not RTU
# ANTHROPIC_AUTH_TOKEN=
# REVY_ANTHROPIC_GATEWAY_MODEL=
# AWS Bedrock (optional — IAM role on droplet; unused, keep for later)
# AWS_REGION=eu-central-1
# REVY_JUDGE_PROVIDER=bedrock
# REVY_BEDROCK_JUDGE_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
# REVY_REVIEWER_PROVIDER=bedrock
# REVY_BEDROCK_REVIEWER_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
# REVY_BEDROCK_INFERENCE_PROFILE_ARN=

# -----------------------------------------------------------------------------
# Revy data paths (mounted into worker containers)
# -----------------------------------------------------------------------------
REVY_REPOS_ROOT=/opt/revy/data/repos
REVY_WORKTREES_ROOT=/opt/revy/data/worktrees
REVY_HF_CACHE_PATH=/opt/revy/data/hf-cache

# REVY_EMBEDDING_BACKEND=voyage
# REVY_RERANKER_BACKEND=bge-reranker-v2-m3

# -----------------------------------------------------------------------------
# Review SLAs (seconds — match architecture hard timeouts)
# -----------------------------------------------------------------------------
REVY_DEFAULT_REVIEW_PROFILE=standard
REVY_REVISION_TIMEOUT_STANDARD_SECONDS=900
REVY_REVISION_TIMEOUT_DEEP_SECONDS=1500
REVY_REVISION_TIMEOUT_CRITICAL_SECONDS=1800

# Celery safety nets (per-task, shorter than revision timeout)
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE_PROD=0.1

# -----------------------------------------------------------------------------
# Email (production)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mailgun
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Revy
APP_PUBLIC_URL=https://app.example.com
APP_NAME=Revy

# -----------------------------------------------------------------------------
# Stripe billing (optional) — docs/utils/STRIPE_BILLING_SETUP.md
# -----------------------------------------------------------------------------
# STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.com/settings/billing?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=https://app.example.com/settings/billing?checkout=cancel

# -----------------------------------------------------------------------------
# Data export (W6 lifecycle — optional)
# -----------------------------------------------------------------------------
EXPORT_STORAGE_PATH=/data/exports
# EXPORT_TTL_DAYS=7
# Celery: run worker with -Q maintenance,default (export + maintenance tasks)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=example.com
# MAILGUN_REGION=eu
