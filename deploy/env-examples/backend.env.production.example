# deploy/env-examples/backend.env.production.example
# Production runtime — droplet path: /mnt/revy/backend/.env
# Permissions: chmod 600, owned by root or deploy user.
#
# cp deploy/env-examples/backend.env.production.example /mnt/revy/backend/.env
#
# Mounted into: revy-api, revy-worker*, revy-beat (and revy-kc — Keycloak section below).
# NOT used by revy-web (static SPA — VITE_* baked at CI build time).
#
# Container DNS names apply inside revy-net (e.g. redis, keycloak).

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
SECRET_KEY=GENERATE_WITH_python_-c_import_secrets_token_urlsafe_48
ALLOWED_ORIGINS=https://revy.example.com

# -----------------------------------------------------------------------------
# Database — DigitalOcean managed PostgreSQL 17 + pgvector
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://revy_app:CHANGE_ME@db-host.db.ondigitalocean.com:25060/revy?ssl=require

# -----------------------------------------------------------------------------
# Redis — revy-redis container on same droplet
# -----------------------------------------------------------------------------
REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_REDIS_PASSWORD@redis:6379/1
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# Keycloak — revy-kc container (also set KC_* for the Keycloak image)
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=revy
KEYCLOAK_CLIENT_ID=revy-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_FRONTEND_CLIENT_ID=revy-web
# KEYCLOAK_WEBHOOK_SECRET=

REGISTRATION_REQUIRE_ADMIN_APPROVAL=false
REGISTRATION_REQUIRE_PROFILE_FORM=false

# Keycloak server bootstrap (container env — often duplicated in compose `environment:`)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://db-host.db.ondigitalocean.com:25060/keycloak?sslmode=require
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
# KC_HTTP_RELATIVE_PATH=/auth

# -----------------------------------------------------------------------------
# GitHub App
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/mnt/revy/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
REVY_BOT_LOGIN=revy[bot]

# -----------------------------------------------------------------------------
# Model providers
# -----------------------------------------------------------------------------
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# -----------------------------------------------------------------------------
# Revy data paths (mounted into worker containers)
# -----------------------------------------------------------------------------
REVY_REPOS_ROOT=/data/repos
REVY_WORKTREES_ROOT=/data/worktrees
REVY_HF_CACHE_PATH=/data/hf-cache

# REVY_EMBEDDING_BACKEND=voyage
# REVY_RERANKER_BACKEND=bge-reranker-v2-m3

# -----------------------------------------------------------------------------
# Review SLAs (seconds — match architecture hard timeouts)
# -----------------------------------------------------------------------------
REVY_DEFAULT_REVIEW_PROFILE=standard
REVY_REVISION_TIMEOUT_STANDARD_SECONDS=900
REVY_REVISION_TIMEOUT_DEEP_SECONDS=1500
REVY_REVISION_TIMEOUT_CRITICAL_SECONDS=1800

# Celery safety nets (per-task, shorter than revision timeout)
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE_PROD=0.1

# -----------------------------------------------------------------------------
# Email (production)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mailgun
EMAIL_FROM=noreply@revy.example.com
EMAIL_FROM_NAME=Revy
APP_PUBLIC_URL=https://revy.example.com
APP_NAME=Revy
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=revy.example.com
# MAILGUN_REGION=eu
