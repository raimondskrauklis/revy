# deploy/keycloak/config/.env
# RUNTIME — read by docker compose from this directory (env_file: .env)
# chmod 600
#
# Build-time (KC_DB, KC_HEALTH_ENABLED, KC_METRICS_ENABLED) is in Dockerfile.
# Rebuild image if you change those: docker compose build --no-cache
#
# Issuer: https://auth.revy.createit.digital/realms/revy
# Backend: KEYCLOAK_URL=http://keycloak:8080 (compose alias on revy-net)

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://db-pgsql-fra1-18565-do-user-14700337-0.h.db.ondigitalocean.com:25060/revy-sec-staging?sslmode=require
KC_DB_USERNAME=sec-user-staging
KC_DB_PASSWORD=CHANGE_ME

KC_HOSTNAME=https://auth.revy.createit.digital
KC_HOSTNAME_STRICT=true
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_PROXY_TRUSTED_ADDRESSES=127.0.0.1

KC_LOG_LEVEL=INFO
