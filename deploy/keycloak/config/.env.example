# deploy/keycloak/config/.env.example
# RUNTIME — copy to .env and set real values before starting Keycloak.
# chmod 600
#
# Build-time (KC_DB, KC_HEALTH_ENABLED, KC_METRICS_ENABLED) is in Dockerfile.
# Rebuild image if you change those: docker compose build --no-cache
#
# Example domain layout: SPA/API on https://app.example.com, Keycloak on https://auth.example.com
# Backend inside compose network: KEYCLOAK_URL=http://keycloak:8080

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://DB_HOST:5432/keycloak?sslmode=require
KC_DB_USERNAME=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME

KC_HOSTNAME=https://auth.example.com
KC_HOSTNAME_STRICT=true
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_PROXY_TRUSTED_ADDRESSES=127.0.0.1

KC_LOG_LEVEL=INFO

# vymalo/keycloak-webhook 0.10.0-rc.1 — identity events to Revy API (internal revy-net)
# Must match KEYCLOAK_WEBHOOK_SECRET in backend .env.
WEBHOOK_HTTP_BASE_PATH=http://revy-api:8000/api/v1/webhooks/keycloak
WEBHOOK_HTTP_AUTH_USERNAME=revy
WEBHOOK_HTTP_AUTH_PASSWORD=CHANGE_ME_SAME_AS_KEYCLOAK_WEBHOOK_SECRET
WEBHOOK_EVENTS_TAKEN=REGISTER,IDENTITY_PROVIDER_FIRST_LOGIN,IDENTITY_PROVIDER_LINK,UPDATE_PROFILE,UPDATE_EMAIL,DELETE_ACCOUNT
