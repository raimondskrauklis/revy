-- Basic connection rights
GRANT ALL PRIVILEGES ON DATABASE "revy-dev" TO "revy-user-dev";

-- Allow the user to use and create objects in public schema
GRANT USAGE, CREATE ON SCHEMA public TO "revy-user-dev";

-- Grant full rights on everything that currently exists
GRANT ALL ON ALL TABLES IN SCHEMA public TO "revy-user-dev";
GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO "revy-user-dev";
GRANT ALL ON ALL FUNCTIONS IN SCHEMA public TO "revy-user-dev";

-- Grant full rights on everything that will be created in the future
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO "revy-user-dev";
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO "revy-user-dev";
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON FUNCTIONS TO "revy-user-dev";

-- Give schema ownership (updated to match new user)
ALTER SCHEMA public OWNER TO "revy-user-dev";

-- Allow usage + create
GRANT USAGE, CREATE ON SCHEMA public TO "revy-user-dev";

-- Default privileges for new tables/sequences
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO "revy-user-dev";
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO "revy-user-dev";

