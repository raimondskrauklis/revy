# backend/.env.example
# Copy to backend/.env for local development (DO NOT COMMIT .env)
#
#   cp .env.example .env
#
# Dev bootstrap: docs/starter-pack/DEV_BOOTSTRAP.md
# Registration flags: docs/starter-pack/REGISTRATION_FLAGS.md
#
# PostgreSQL: DigitalOcean managed — run deploy/sql/postgres-extensions.sql once per DB.
# Redis: start local broker with `docker compose up -d` in this directory.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console
SECRET_KEY=local-dev-only-change-me
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database — DigitalOcean managed PostgreSQL 17
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://revy_app:CHANGE_ME@db-host.db.ondigitalocean.com:25060/revy?ssl=require
TEST_DATABASE_URL=postgresql+asyncpg://revy_app:CHANGE_ME@db-host.db.ondigitalocean.com:25060/revy_test?ssl=require
# Operator-only — staging metrics scripts (not used by the app)
# PRODUCTION_DATABASE_URL=postgresql+asyncpg://revy-user-staging:CHANGE_ME@db-host.db.ondigitalocean.com:25060/revy-staging?ssl=require

# -----------------------------------------------------------------------------
# Redis (backend/docker-compose.yml — local broker only)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=revy
# Optional when KEYCLOAK_URL is internal (docker) but browser tokens use a public issuer:
# KEYCLOAK_ISSUER=https://auth.revy.createit.digital/realms/revy
KEYCLOAK_CLIENT_ID=revy-api
KEYCLOAK_CLIENT_SECRET=local-revy-api-secret
KEYCLOAK_FRONTEND_CLIENT_ID=revy-web
# KEYCLOAK_WEBHOOK_SECRET=

# Registration — USER_REGISTRATION.md (mirror frontend VITE_REGISTRATION_*)
# Pairing table: docs/starter-pack/REGISTRATION_FLAGS.md
REGISTRATION_REQUIRE_ADMIN_APPROVAL=false
REGISTRATION_REQUIRE_PROFILE_FORM=false

# One-time first deploy — DELETE after super admin first login
# BOOTSTRAP_SUPER_ADMIN_EMAIL=you@example.com

# Email — console local, mailgun production
EMAIL_PROVIDER=console
APP_PUBLIC_URL=http://localhost:5173
# EMAIL_FROM=noreply@localhost
# EMAIL_FROM_NAME=Revy
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_REGION=eu

# -----------------------------------------------------------------------------
# GitHub App (dev/test installation)
#
# Private key: file on disk, never in this repo.
#   Production droplet: /mnt/revy_volume/secrets/github-app.pem (chmod 640, chown 1000:deploy — see docs/utils/GITHUB_APP_SETUP.md)
#   Local: absolute path outside the repo, e.g. ~/.config/revy/github-app.pem
# GITHUB_APP_ID = App settings → About (NOT installation URL id)
# Client secrets on the GitHub App page are OAuth-only — not used by the backend.
# App JWT lifetime: iat = now-60, exp = iat+600 (see docs/utils/GITHUB_APP_SETUP.md § App JWT).
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github-app.pem
GITHUB_WEBHOOK_SECRET=local-webhook-secret
REVY_BOT_LOGIN=revy[bot]

# -----------------------------------------------------------------------------
# Embeddings (R3 indexing) — architecture.md §11.3.1
# Start with Voyage API; keep local/HF path documented for parallel experiments.
# -----------------------------------------------------------------------------
REVY_EMBEDDING_BACKEND=voyage
# voyage (shipped R3 v1) | local (self-hosted — not implemented yet)
VOYAGE_API_KEY=
REVY_EMBEDDING_MODEL=voyage-code-3
# Must include leading "v" — typos like "oyage-code-3" return Voyage HTTP 400
REVY_EMBEDDING_DIMENSIONS=1024
# Legacy R3 v1: voyage-3-lite @ 512 (requires migration 0021 downgrade + re-index to switch back)
# REVY_EMBEDDING_MODEL=voyage-3-lite
# REVY_EMBEDDING_DIMENSIONS=512
# Local parallel track (when EmbeddingBackend ships):
# REVY_HF_CACHE_PATH=/tmp/revy/hf-cache
# REVY_LOCAL_EMBEDDING_MODEL=jina-embeddings-v2-base-code
# Reranker (future hybrid retrieval §11.3 — not R3 v1):
# REVY_RERANKER_BACKEND=bge-reranker-v2-m3

# -----------------------------------------------------------------------------
# LLM review + judge — architecture.md §13–14
# -----------------------------------------------------------------------------
# Live path is RTU (llm.ai.rtu.lv): one origin, one key, two transports.
#   reviewer — OpenAI-compatible POST /v1/chat/completions
#   judge    — Anthropic-compatible POST /v1/messages
# Moonshot.ai and direct Anthropic stay for switch-back; Bedrock unused.
#   standard  — azure_ai/kimi-k2.7-code
#   deep/crit — azure_ai/claude-fable-5-1
#   judge     — azure_ai/claude-opus-5
REVY_REVIEWER_PROVIDER=rtu
REVY_JUDGE_PROVIDER=rtu
# Deprecated alias for REVY_REVIEWER_PROVIDER; kept for one release
REVY_LLM_PROVIDER=rtu
RTU_API_BASE=https://llm.ai.rtu.lv
RTU_API_KEY=
REVY_RTU_MODEL_STANDARD=azure_ai/kimi-k2.7-code
REVY_RTU_MODEL_DEEP=azure_ai/claude-fable-5-1
REVY_RTU_MODEL_CRITICAL=azure_ai/claude-fable-5-1
REVY_RTU_MODEL_JUDGE=azure_ai/claude-opus-5

# Moonshot.ai — unused while REVY_REVIEWER_PROVIDER=rtu
# REVY_REVIEWER_PROVIDER=moonshot
REVY_MOONSHOT_MODEL_STANDARD=kimi-k2.7-code
REVY_MOONSHOT_MODEL_DEEP=kimi-k3
REVY_MOONSHOT_MODEL_CRITICAL=kimi-k3
# K2 thinking: reasoning + JSON share this budget (default 32768; min 16000).
# REVY_MOONSHOT_MAX_COMPLETION_TOKENS=32768
MOONSHOT_API_BASE=https://api.moonshot.ai/v1
MOONSHOT_API_KEY=

# Direct Anthropic (api.anthropic.com) — unused while providers are rtu
# REVY_REVIEWER_PROVIDER=anthropic
# REVY_JUDGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
REVY_ANTHROPIC_MODEL=claude-sonnet-5
# REVY_JUDGE_STRUCTURED_OUTPUT=false
# Anthropic-compatible proxy only — do not point this at RTU
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# REVY_ANTHROPIC_GATEWAY_MODEL=

# AWS Bedrock (optional — MODEL_POLICY M1; unused, keep for later)
# AWS_REGION=eu-central-1
# REVY_JUDGE_PROVIDER=bedrock
# REVY_BEDROCK_JUDGE_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
# REVY_REVIEWER_PROVIDER=bedrock
# REVY_BEDROCK_REVIEWER_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
# Optional inference profile (documented; v1 uses modelId when unset):
# REVY_BEDROCK_INFERENCE_PROFILE_ARN=

# -----------------------------------------------------------------------------
# Revy paths (runtime data — NOT in this repo)
#
# Production (droplet block volume → worker container mount):
#   Host:  /mnt/revy/repos/          /mnt/revy/worktrees/
#   Env:   REVY_REPOS_ROOT=/data/repos   REVY_WORKTREES_ROOT=/data/worktrees
#
# Local: create dirs outside the repo, same env var names. Example:
#   mkdir -p /tmp/revy/repos /tmp/revy/worktrees
# -----------------------------------------------------------------------------
REVY_REPOS_ROOT=/tmp/revy/repos
REVY_WORKTREES_ROOT=/tmp/revy/worktrees

# -----------------------------------------------------------------------------
# Stripe billing (optional — STRIPE_ENABLED=false skips Checkout/Portal)
# Setup: docs/utils/STRIPE_BILLING_SETUP.md
# -----------------------------------------------------------------------------
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/settings/billing?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/settings/billing?checkout=cancel

# -----------------------------------------------------------------------------
# Data export (W6 — local path; set on API + worker in production)
# -----------------------------------------------------------------------------
# EXPORT_STORAGE_PATH=/tmp/revy/exports
# EXPORT_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Review defaults
# -----------------------------------------------------------------------------
REVY_DEFAULT_REVIEW_PROFILE=standard
REVY_REVISION_TIMEOUT_STANDARD_SECONDS=900
REVY_REVISION_TIMEOUT_DEEP_SECONDS=1500
REVY_REVISION_TIMEOUT_CRITICAL_SECONDS=1800

# Moonshot / engineering context caps (RCX — default 512 KB diff)
# REVY_DIFF_MAX_BYTES=524288
# REVY_ENGINEERING_CONTEXT_MAX_BYTES=32768
# REVY_PR_BODY_MAX_BYTES=4096

# Pipeline trace retention (review-quality O8)
PIPELINE_RETENTION_DAYS=90

# Generation lifecycle — seconds to wait after synchronize before autostart enqueue (0=off, max 10)
# REVIEW_COALESCE_SECONDS=0

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENABLE_IN_TEST=false

# Pipenv — keep .venv inside backend/ (loaded from backend/.env)
PIPENV_VENV_IN_PROJECT=1
